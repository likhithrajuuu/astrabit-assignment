# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Postgres — your database connection (used by Spring datasource + Flyway)
DATABASE_URL="jdbc:postgresql://<host>/<database>?sslmode=require"
DATABASE_URL_POOLED="jdbc:postgresql://<pooled-host>/<database>?sslmode=require"
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Storage — S3-compatible object storage (reserved for future use, not yet read by the app)
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# Discord — credentials from your application in the Discord Developer Portal
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# Gemini — powers /ask, /roast, and /report's AI triage (see spring.ai.google.genai in application.yaml)
GEMINI_API_KEY=
GEMINI_PROJECT_NUMBER=
